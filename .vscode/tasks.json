{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create .venv and install",
      "type": "shell",
      "command": "py -3.11 -m venv .venv; .venv\\Scripts\\python -m pip install --upgrade pip; .venv\\Scripts\\python -m pip install -e \".[soundfont,dev]\" pyinstaller",
      "problemMatcher": []
    },
    {
      "label": "Run JD-Xi Studio",
      "type": "shell",
      "command": ".venv\\Scripts\\python -m jdxi_editor.main",
      "problemMatcher": []
    },
    {
      "label": "Tests: all",
      "type": "shell",
      "command": ".venv\\Scripts\\python -m pytest tests -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Translations: update, compile, check",
      "type": "shell",
      "command": ".venv\\Scripts\\python -m building.i18n update; .venv\\Scripts\\python -m building.i18n compile; .venv\\Scripts\\python -m building.i18n check",
      "problemMatcher": []
    },
    {
      "label": "Build: Windows exe (PyInstaller)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File building\\windows\\local_build.ps1",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build: installer (Inno Setup)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File building\\windows\\local_build.ps1 -Installer",
      "problemMatcher": []
    }
  ]
}
